# ==========================================
# SUPABASE SECRETS (DO NOT COMMIT)
# ==========================================
POSTGRES_PASSWORD=your_secure_postgres_password
JWT_SECRET=your_super_secret_jwt_string_at_least_32_characters_long

# ==========================================
# PORTS
# ==========================================
# The API gateway exposed port. You should put a reverse proxy (Nginx, Traefik, Caddy) in front of this with HTTPS.
API_PORT=8000
# The Postgres port, bound only to 127.0.0.1. Do NOT expose this directly to the internet.
POSTGRES_PORT=5432

# ==========================================
# AUTH CONFIGURATION
# ==========================================
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:1420,tauri://localhost
JWT_EXPIRY=3600

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
